# Copy to .env and fill in.

# Where everything for this stack is stored (game data ~15 GB, your save, certificates, Tailscale state).
# The default, ../.., is the folder that holds this repo, so the layout is:
#   exvius/repo/      this repository
#   exvius/data/      game data
#   exvius/server/    save, certificates, logs
#   exvius/tailscale/ Tailscale state
# Any absolute path works too, e.g. D:/exvius or /mnt/user/appdata/ffbe.
FFBE_DIR=../..

# A one-time Tailscale auth key (admin console > Settings > Keys > Generate auth key).
# Only needed for the first start; you can blank it afterwards.
TS_AUTHKEY=
